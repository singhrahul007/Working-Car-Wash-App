{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,

    "baseUrl": ".",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "jsx": "react-native",

    "paths": {
      "api/*": ["src/api/*"],
      "*": ["node_modules/*"]
    },

    "ignoreDeprecations": "5.0"
  },
  "exclude": ["node_modules", "android", "ios"]
}
