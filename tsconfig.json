{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "jsx": "react-native",
    "target": "ES2020",

    "paths": {
      "api/*": ["src/api/*"]
    },

    "ignoreDeprecations": "5.0"
  },
  "include": ["App.js", "index.js", "src/**/*.js", "src/**/*.jsx"],
  "exclude": ["node_modules", "android", "ios", "dist"]
}
